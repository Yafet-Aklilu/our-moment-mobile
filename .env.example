# Copy from .env.example and adjust for your machine / device.

# Laravel mobile API (no trailing slash).
# On a physical phone/emulator, 127.0.0.1 is the phone itself — use your Mac's
# current LAN IP (Wi‑Fi → IP address), e.g. http://192.168.1.4:8000/api/v1
# Re-check this whenever your Wi‑Fi IP changes, then restart Expo (`npx expo start -c`).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Canonical web origin used for share links + Universal Links host
EXPO_PUBLIC_WEB_ORIGIN=https://ourmoment.app

# Optional: origin for Laravel public assets (template covers).
# Defaults to the API host without /api/v1 — e.g. http://192.168.1.4:8000
# EXPO_PUBLIC_ASSET_ORIGIN=http://192.168.1.4:8000
